{
  "name": "gourmet-street-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "grant-cash": "node --env-file-if-exists=.env scripts/grant-cash.ts",
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "test": "node --env-file-if-exists=.env --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=80 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "hono": "4.13.13",
    "postgres": "3.4.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "7.0.2"
  }
}
