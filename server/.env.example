# Copy to .env and adjust. .env is git-ignored.
DATABASE_URL=postgres://localhost/gourmet_street
PORT=3000
# Item prices for the shop. Defaults to the file tools/extract_data.py writes.
# ITEM_CATALOG_PATH=../data/restaurant.json

# Used only by `npm test`. Tests truncate every table, so the database name must end in _test.
TEST_DATABASE_URL=postgres://localhost/gourmet_street_test
